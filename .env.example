# bia-roommate environment contract (Next.js app only — george/ backend has
# its own env, documented separately). Every variable the app reads via
# process.env across app/, lib/, middleware.ts is listed here with the
# surface that reads it and whether it is required.
#
# Copy to .env.local for local dev. NEVER commit real values.

# ──────────────────────────────────────────────────────────────────────────
# Supabase (REQUIRED — auth, profiles, shipping, course ratings, feedback)
# ──────────────────────────────────────────────────────────────────────────

# Read by: lib/supabase/client.ts, server.ts, middleware.ts, admin.ts,
# lib/articles.ts. NEXT_PUBLIC_* values are exposed to the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
# Anon (publishable) key — RLS-scoped. Required.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — BYPASSES RLS. Read by lib/supabase/admin.ts
# (createAdminSupabaseClient), which THROWS if unset.
#
# ⚠️ CONTRADICTION — needs an explicit team decision:
#   The documented security boundary (and the PR #62 events revert
#   diagnosis) says this app runs WITHOUT a service-role key. But two LIVE
#   public routes call createAdminSupabaseClient() and 500 without it:
#     - app/api/shipping/history/route.ts (GET, public)
#     - app/api/shipping/routes/route.ts  (GET, public)
#   Plus lib/api/authed-handler.ts adminHandler() for /api/shipping admin
#   routes. Either refactor those reads to RLS/RPC and remove the key, or
#   accept that the key exists in prod and update the documented boundary.
SUPABASE_SERVICE_ROLE_KEY=

# ──────────────────────────────────────────────────────────────────────────
# Admin gating
# ──────────────────────────────────────────────────────────────────────────

# Comma-separated, lowercased email allowlist. Read by lib/admin.ts
# (requireAdmin / getAuthContext) gating shipping admin APIs and pages.
# Required for admin surfaces; without it no one passes the admin gate.
ADMIN_EMAILS=

# ──────────────────────────────────────────────────────────────────────────
# LLM course planner (/api/courses/agent-stream, /api/courses/recommend)
# ──────────────────────────────────────────────────────────────────────────

# Read by lib/course-planner/agent/llm-client.ts plus the two routes above.
# Provider precedence: ANTHROPIC > OPENAI > NVIDIA. All optional — with no
# key, /recommend falls back to keyword matching ("free mode") and
# /agent-stream returns 503. Both endpoints are public but rate limited
# per IP by COST CLASS (lib/api/ip-rate-limit.ts): LLM paths (agent-stream,
# and recommend with mode !== "free") share a tight 5/min + 30/day budget;
# recommend's keyword-only mode:"free" path burns no keys and gets a loose
# 60/min anti-scraping cap with no daily limit, so shared-egress callers
# (the live George bot, campus NAT) are not throttled.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=
# Optional override for the NVIDIA main model (defaults in llm-client.ts).
NVIDIA_MODEL=
# Optional separate key/model for the fast interpreter path.
NVIDIA_FAST_KEY=
NVIDIA_FAST_MODEL=

# ──────────────────────────────────────────────────────────────────────────
# George web-chat relay (/api/george/chat → george/ Express backend)
# ──────────────────────────────────────────────────────────────────────────

# Public URL of the george backend (Cloudflare Tunnel in front of :3001)
# and its bearer token. Read by app/api/george/chat/route.ts. Optional in
# the sense that the route degrades to a friendly "George is being
# fine-tuned" message when unset; required for web chat to actually work.
GEORGE_BACKEND_URL=
GEORGE_ADMIN_TOKEN=

# ──────────────────────────────────────────────────────────────────────────
# George signup funnel / Squad handoff (iMessage pool number deep-links)
# ──────────────────────────────────────────────────────────────────────────

# Slice B onboarding: the shared george iMessage pool number students text
# to sign up, plus the landing URL.
GEORGE_IMESSAGE_PHONE=+1XXXXXXXXXX
NEXT_PUBLIC_GEORGE_LANDING_URL=https://uscbia.com/george

# Squad Phase 3 — public george pool number for the 加入 handoff deep-link.
# Mirrors GEORGE_IMESSAGE_PHONE. If unset, the 加入 confirm shows a plain
# "iMessage george 报名" instruction without a prefilled message.
NEXT_PUBLIC_GEORGE_IMESSAGE_PHONE=+1XXXXXXXXXX

# ──────────────────────────────────────────────────────────────────────────
# Chrome extension CORS
# ──────────────────────────────────────────────────────────────────────────

# Extension ID allowed by lib/cors.ts on the course/RMP API routes.
# Optional — when unset, only the production web origin gets CORS headers.
ALLOWED_EXTENSION_ID=

# ──────────────────────────────────────────────────────────────────────────
# Analytics (PostHog — exposed to the browser bundle)
# ──────────────────────────────────────────────────────────────────────────

# Read by lib/analytics/posthog-sink.ts. Optional — analytics is a no-op
# when the key is unset (safe to ship without).
NEXT_PUBLIC_POSTHOG_KEY=
# Optional; defaults to https://us.i.posthog.com.
NEXT_PUBLIC_POSTHOG_HOST=
