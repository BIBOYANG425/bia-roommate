# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# NOTE: unanchored so nested copies (e.g. store-assets/node_modules) are ignored too
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.example is the committed env contract — no secrets, names only
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# chrome extension build
extension/dist/
extension/node_modules/

# WeChat raw exports — contains PII, never commit
george/data/wechat/

# Distilled voice skills — contain verbatim chat adjacent content + cloned tooling
.claude/skills/

# Local tool state — not meant to be shared
.codex/
.gstack/

# Local session-log backups (the real logs are committed; .bak copies are local)
.claude/session-logs/*.local.bak.md

# R session history (never relevant to this app)
.Rhistory
.Rapp.history

# Loose non-code material that was committed by accident — kept on disk, out of git
Downloads/
Documents/
BIA service Content Strategy/

# store-assets: keep listing assets, ignore build output / packaged extension
store-assets/bia-course-helper/
store-assets/*.zip
